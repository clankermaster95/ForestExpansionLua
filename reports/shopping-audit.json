  "features": [
    "Ancient recipe sales buy only missing components, recursively, at current object-data prices; use owned ingredients first; refund the scroll on failure.",
    "Shop range entry and shop selection assign the current Ancient as buyer for its owning player with a synchronized neutralinteract order.",
    "One editable recipe catalog covers eleven sold recipes and the two-ledger combination; regular builds regenerate Lua prices."
  ],
  "fixes": [
    {
      "id": "unit-index-corruption",
      "detail": "Focused Anger no longer overwrites the attacked unit custom value. Per-attacker capped stacks and timer closures preserve the index and attacker."
    },
    {
      "id": "singleton-force-corruption",
      "detail": "Expander membership uses a dedicated force, leaving Blizzard player-0 singleton intact for Damage Engine callbacks."
    },
